{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootfabric.github.io/NanoLab/schemas/release/release-manifest.v1.json",
  "title": "NanoLab components package RELEASE_MANIFEST.json schema v1",
  "description": "Content manifest of a NanoLab component release package: every file with SHA-256, size and role. Verified by recomputing digests (release.card_lint manifest verify). The manifest never lists itself. Executable by scripts/release/mini_schema.py.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "package",
    "package_version",
    "generated_at_utc",
    "generated_by",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "nanolab_release_manifest"},
    "package": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "generated_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "generated_by": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]},
      "description": "Optional: repo/commit the package was cut from."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes", "role"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "pattern": "^[^\\s]+$", "description": "POSIX path relative to package root; no leading '/', no '..', no backslash (semantic check)."},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "role": {
            "enum": ["schema", "card", "family", "protocol", "report", "provenance", "reproduction", "rights", "citation", "metadata", "other"]
          }
        }
      }
    }
  }
}
