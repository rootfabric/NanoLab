{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootfabric.github.io/NanoLab/schemas/release/rights.v1.json",
  "title": "NanoLab components package RIGHTS.json schema v1",
  "description": "Rights declaration for a NanoLab component release package. Executable by scripts/release/mini_schema.py. The owner license decision (program D2) is expressed only through own_code_license / own_docs_data_license; UNDECIDED_PENDING_OWNER_DECISION keeps the package draft-only (publication blocked). UNKNOWN is not a permission. See docs/release/RELEASE_CONTRACT_V0_1.md and LICENSE_POLICY.md.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "package",
    "package_version",
    "own_code_license",
    "own_docs_data_license",
    "policy",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "nanolab_components_rights"},
    "package": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "own_code_license": {
      "enum": ["UNDECIDED_PENDING_OWNER_DECISION", "MIT", "Apache-2.0", "GPL-3.0-only", "GPL-3.0-or-later", "BSD-3-Clause"]
    },
    "own_docs_data_license": {
      "enum": ["UNDECIDED_PENDING_OWNER_DECISION", "CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0"]
    },
    "policy": {
      "type": "object",
      "required": ["durable_cache", "download_on_run"],
      "additionalProperties": false,
      "properties": {
        "durable_cache": {"enum": ["FORBIDDEN", "ALLOWED"]},
        "download_on_run": {"type": "boolean"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "rights_mode", "redistribution"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "pattern": "^[^\\s]+$", "description": "POSIX glob relative to package root; no leading '/', no '..' (semantic check)."},
          "rights_mode": {"enum": ["OWN", "REFERENCE_ONLY", "DOWNLOAD_ON_RUN", "MIXED", "UNKNOWN"]},
          "redistribution": {"enum": ["ALLOWED", "METADATA_ONLY", "CONDITIONAL", "FORBIDDEN"]},
          "upstream_repo": {"type": "string"},
          "pinned_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "derived_results_publishable": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
