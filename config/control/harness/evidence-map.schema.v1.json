{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NanoLab Evidence Map v1 (campaign-level)",
  "description": "Campaign-level evidence map: the review unit of one accepted campaign. NL2-003 hygiene fix F-1/O3: the schema follows the de-facto convention of the published accepted campaign maps E1-R1 (NL1-002), E0-R4 (NL2-001) and E1-R2 (NL2-002); the previous checkpoint-shaped v1 schema never materialized in any published evidence-map and rejected all three campaign maps with 11 identical errors. The schema is the structural ceiling for the identity/provenance core; analytic sections (statistics, seed policy, integrity, errata, ...) are campaign-specific and intentionally open (additionalProperties), their semantics are enforced by review, not by this schema.",
  "type": "object",
  "required": ["schema_version", "kind", "campaign_id", "experiment_id", "work_order_id", "execution_id", "branch", "base_sha", "risk_class", "claim", "runs", "failed_or_excluded_runs", "remaining_risks", "next_action"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "evidence_map"},
    "campaign_id": {"type": "string", "minLength": 3},
    "experiment_id": {"type": "string", "minLength": 2},
    "work_order_id": {"type": "string", "minLength": 3},
    "execution_id": {"type": "string", "pattern": "^EX-", "minLength": 3},
    "branch": {"type": "string", "minLength": 3},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "risk_class": {"type": "string", "minLength": 3},
    "claim": {
      "type": "object",
      "description": "Published claim ceiling and campaign-level scientific outcome. Implementer publications keep campaign_scientific_outcome = NOT_EVALUATED (acceptance is a Director act).",
      "required": ["campaign_scientific_outcome", "campaign_ceiling"],
      "properties": {
        "class_published": {"type": "string"},
        "campaign_ceiling": {"type": "string"},
        "campaign_scientific_outcome": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "INCONCLUSIVE", "NOT_EVALUATED", "INVALIDATED"]},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "protocol_lineage": {"type": "object"},
    "exact_subject": {"type": "object"},
    "environment": {"type": "object"},
    "inputs": {"type": "object"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["run_id", "execution_outcome"],
        "properties": {
          "run_id": {"type": "string", "minLength": 3},
          "type": {"type": "string"},
          "family": {"type": "string"},
          "execution_outcome": {"enum": ["COMPLETED", "FAILED_TECHNICAL", "ABORTED", "BLOCKED_ENVIRONMENT"]},
          "scientific_outcome": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "INCONCLUSIVE", "NOT_EVALUATED", "INVALIDATED"]}
        },
        "additionalProperties": true
      }
    },
    "seed_distinctness": {"type": "object"},
    "pilot_statistics": {"type": "object"},
    "confirmatory_statistics": {"type": "object"},
    "uncertainty_separation": {"type": "object"},
    "integrity": {"type": "object"},
    "r_confirm_freeze": {"type": "object"},
    "measured_budget": {"type": "object"},
    "resource_usage": {"type": "object"},
    "changed_surfaces": {"type": "array", "items": {"type": "string"}},
    "experiment_runs": {"type": "array", "items": {"type": "string"}},
    "failed_or_excluded_runs": {"type": "array"},
    "failed_prior_attempts_preserved": {"type": "array"},
    "remaining_risks": {"type": "array", "items": {"type": "string"}},
    "errata": {"type": "object"},
    "recommendation_for_director": {"type": "string"},
    "next_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
