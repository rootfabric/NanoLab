{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NanoLab Evidence Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_order_id", "checkpoint", "risk_class", "claim_class", "subject_sha", "changed_surfaces", "experiment_runs", "validation", "artifacts", "remaining_risks", "review_verdict", "scientific_conclusion", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": 1},
    "work_order_id": {"type": "string"},
    "checkpoint": {"type": "string"},
    "risk_class": {"type": "string"},
    "claim_class": {"type": "string"},
    "subject_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject_tree": {"type": ["string", "null"]},
    "changed_surfaces": {"type": "array", "items": {"type": "string"}},
    "experiment_runs": {"type": "array", "items": {"type": "string"}},
    "validation": {"type": "array", "items": {"type": "object"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "failed_or_inconclusive": {"type": "array", "items": {"type": "string"}},
    "remaining_risks": {"type": "array", "items": {"type": "string"}},
    "required_fixes": {"type": "array", "items": {"type": "string"}},
    "review_verdict": {"enum": ["PASS", "FAIL", "INSUFFICIENT_EVIDENCE", "NOT_REVIEWED"]},
    "scientific_conclusion": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "INCONCLUSIVE", "NOT_EVALUATED", "INVALIDATED"]},
    "claim_ceiling": {"type": "string"}
  }
}
